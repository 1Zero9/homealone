datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MEMBER
  BACKUP_ADMIN
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_UNION
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  LOAN
  INVESTMENT
  OTHER
}

model Household {
  id         String   @id @default(cuid())
  name       String   @default("Our Household")
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users     User[]
  expenses  Expense[]
  incomes   Income[]
  accounts  Account[]
  transfers Transfer[]
  goals     Goal[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(MEMBER)
  avatarUrl String?

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
  incomes  Income[]
  sessions Session[]
  accountsCreated Account[]
  transfersCreated Transfer[]
  goalsCreated     Goal[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Expense {
  id              String   @id @default(cuid())
  name            String
  amount          Float
  currency        String   @default("EUR")
  billingCycle    String   @default("monthly")
  category        String   @default("utilities")
  icon            String   @default("Zap")
  color           String   @default("#3155D9")
  renewalDay      Int      @default(1)
  nextRenewalDate String
  isPaidThisCycle Boolean  @default(false)
  lastPaidAt      DateTime?
  paymentMethod   String   @default("SEPA Direct Debit")
  isActive        Boolean  @default(true)
  notes           String?
  contractEndDate String?
  vendorEmail     String?
  usageRating     String?  @default("high")
  isVariable      Boolean  @default(false)

  householdId     String?
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById     String?
  createdBy       User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  paymentAccountId String?
  paymentAccount    Account? @relation("ExpensePaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)

  transfers Transfer[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([householdId])
  @@index([paymentAccountId])
}

model Income {
  id           String   @id @default(cuid())
  name         String
  amount       Float
  currency     String   @default("EUR")
  frequency    String   @default("monthly")
  category     String   @default("salary")
  isActive     Boolean  @default(true)
  notes        String?

  householdId  String?
  household    Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById  String?
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  depositAccountId String?
  depositAccount    Account? @relation("IncomeDepositAccount", fields: [depositAccountId], references: [id], onDelete: SetNull)

  transfers Transfer[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([householdId])
  @@index([depositAccountId])
}

/// A financial account or payment method (bank, credit union, PayPal, credit
/// card, loan, etc). Sensitive fields (account/routing numbers, login
/// credentials, security notes) are stored AES-256-GCM encrypted at the
/// application layer (see src/lib/crypto.ts) — never in plaintext.
model Account {
  id          String      @id @default(cuid())
  name        String
  institution String?
  type        AccountType @default(OTHER)
  currency    String      @default("EUR")
  notes       String?
  isActive    Boolean     @default(true)

  // Encrypted sensitive fields (format: iv:authTag:ciphertext, base64) —
  // null when not set. Never selected in list/summary API responses.
  accountNumberEnc String?
  routingNumberEnc String?
  loginUsernameEnc String?
  loginPasswordEnc String?
  loginUrlEnc      String?
  securityNotesEnc String?

  // Loan-specific (optional, plaintext — not secret on their own)
  originalAmount Float?
  interestRate   Float?
  termMonths     Int?
  payoffDate     String?

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  expenses Expense[] @relation("ExpensePaymentAccount")
  incomes  Income[]  @relation("IncomeDepositAccount")

  transfersOut Transfer[] @relation("TransferFromAccount")
  transfersIn  Transfer[] @relation("TransferToAccount")
  goals        Goal[]     @relation("GoalAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

/// A single money-movement event — one hop in the "money journey". Either
/// side can be an internal Account, or left null to represent money
/// crossing the household boundary (e.g. salary landing, or a direct debit
/// going out to a vendor). Optionally linked to the recurring Expense/Income
/// record it corresponds to, so the recurring definition and the actual
/// dated movement stay connected.
model Transfer {
  id       String   @id @default(cuid())
  amount   Float
  currency String   @default("EUR")
  date     String
  note     String?

  // Free-text label for whichever side is external (fromAccountId/toAccountId
  // is null) — e.g. "Salary — Acme Corp" or "Netflix direct debit".
  externalLabel String?

  fromAccountId String?
  fromAccount   Account? @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)

  toAccountId String?
  toAccount   Account? @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)

  linkedExpenseId String?
  linkedExpense   Expense? @relation(fields: [linkedExpenseId], references: [id], onDelete: SetNull)

  linkedIncomeId String?
  linkedIncome   Income?  @relation(fields: [linkedIncomeId], references: [id], onDelete: SetNull)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([date])
}

/// A savings/financial goal — optionally tied to an Account (e.g. a savings
/// pot), with a manually-tracked current amount and an optional target date.
model Goal {
  id            String   @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  currency      String   @default("EUR")
  targetDate    String?
  notes         String?
  isActive      Boolean  @default(true)

  linkedAccountId String?
  linkedAccount   Account? @relation("GoalAccount", fields: [linkedAccountId], references: [id], onDelete: SetNull)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

model DatabaseBackup {
  id          String   @id @default(cuid())
  createdById String?
  payloadJson Json
  recordCount Int
  notes       String?
  createdAt   DateTime @default(now())
}
