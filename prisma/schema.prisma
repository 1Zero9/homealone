datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MEMBER
  BACKUP_ADMIN
}

model Household {
  id         String   @id @default(cuid())
  name       String   @default("Our Household")
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users    User[]
  expenses Expense[]
  incomes  Income[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(MEMBER)
  avatarUrl String?

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
  incomes  Income[]
  sessions Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Expense {
  id              String   @id @default(cuid())
  name            String
  amount          Float
  currency        String   @default("EUR")
  billingCycle    String   @default("monthly")
  category        String   @default("utilities")
  icon            String   @default("Zap")
  color           String   @default("#3155D9")
  renewalDay      Int      @default(1)
  nextRenewalDate String
  isPaidThisCycle Boolean  @default(false)
  lastPaidAt      DateTime?
  paymentMethod   String   @default("SEPA Direct Debit")
  isActive        Boolean  @default(true)
  notes           String?
  contractEndDate String?
  vendorEmail     String?
  usageRating     String?  @default("high")
  isVariable      Boolean  @default(false)

  householdId     String?
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById     String?
  createdBy       User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([householdId])
}

model Income {
  id           String   @id @default(cuid())
  name         String
  amount       Float
  currency     String   @default("EUR")
  frequency    String   @default("monthly")
  category     String   @default("salary")
  isActive     Boolean  @default(true)
  notes        String?

  householdId  String?
  household    Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById  String?
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([householdId])
}

model DatabaseBackup {
  id          String   @id @default(cuid())
  createdById String?
  payloadJson Json
  recordCount Int
  notes       String?
  createdAt   DateTime @default(now())
}
