# Postgres connection strings (see prisma/schema.prisma)
DATABASE_URL=
POSTGRES_URL=
PRISMA_DATABASE_URL=

# Optional: powers the free-text "Ask" box on the dashboard.
# Get a key from https://aistudio.google.com/app/apikey
# If unset, the app still works — quick-action cards keep working,
# the ask box just shows a "not configured yet" message.
GOOGLE_AI_API_KEY=

# Optional: sends real sign-in codes and household invite emails via Resend.
# Get a key from https://resend.com/api-keys
# If unset, the app still works — sign-in codes and invites are just logged
# to the server console instead of emailed.
RESEND_API_KEY=
# Optional: verified "from" address (defaults to Resend's onboarding@resend.dev
# test sender, which only delivers to your own Resend account email).
RESEND_FROM_EMAIL=

# Optional: secret used to authenticate the daily contract-reminders cron
# (see vercel.json). Vercel sends this automatically as a Bearer token for
# Cron-triggered requests. If unset, the cron endpoint is left unprotected.
CRON_SECRET=

# Required to store account numbers, routing numbers or login credentials on
# the Accounts feature. 32 raw bytes, base64-encoded — generate with:
#   openssl rand -base64 32
# If unset, sensitive account fields are disabled (everything else in the
# Accounts feature — name, institution, type — still works fine). Never
# reuse this key across environments, and never commit it to git.
CREDENTIALS_ENCRYPTION_KEY=

# Only needed temporarily when running `npm run rotate-key` to rotate
# CREDENTIALS_ENCRYPTION_KEY (e.g. after a suspected leak). Set this to the
# CURRENT key, set CREDENTIALS_ENCRYPTION_KEY above to a newly generated key,
# run the rotation script, then remove this var. See scripts/rotate-encryption-key.ts.
OLD_CREDENTIALS_ENCRYPTION_KEY=
